# Copy to .env.local for local development. Never commit real secrets.
# On Vercel these are set per environment by the Neon integration.

# Pooled connection used by the app at runtime.
DATABASE_URL=postgresql://hsp:hsp@localhost:5432/hsp_dev

# Direct connection used by migrations (scripts/db-migrate.ts).
DATABASE_URL_UNPOOLED=postgresql://hsp:hsp@localhost:5432/hsp_dev

# Set to 1 to skip migrations in `vercel-build` (emergency use only).
# SKIP_DB_MIGRATIONS=1

# Vercel Preview only: non-production Vercel builds skip migrations unless this equals
# "<git branch>@<host[:port]/database>" of the migration URL. It is an operator attestation
# made after checking the endpoint in the Neon console, not proof of its identity
# (docs/deployment.md, "Preview deployments").
# PREVIEW_MIGRATION_APPROVAL=feature/example@ep-example-123456.eu-central-1.aws.neon.tech/neondb

# Auth.js session cookie encryption. Generate one per environment:
#   openssl rand -base64 32
AUTH_SECRET=
# Needed outside Vercel (local `next start`, CI); Vercel is trusted automatically.
AUTH_TRUST_HOST=true

# Integration tests (`pnpm test:integration`) wipe and migrate this database.
# Its name must contain "test".
TEST_DATABASE_URL=postgresql://hsp:hsp@localhost:5432/hsp_test
