# Copy to .env.local for local development. Never commit real secrets.
# On Vercel these are set per environment by the Neon integration.

# Pooled connection used by the app at runtime.
DATABASE_URL=postgresql://hsp:hsp@localhost:5432/hsp_dev

# Direct connection used by migrations (scripts/db-migrate.ts).
DATABASE_URL_UNPOOLED=postgresql://hsp:hsp@localhost:5432/hsp_dev

# Set to 1 to skip migrations in `vercel-build` (emergency use only).
# SKIP_DB_MIGRATIONS=1

# Added in Phase 3 (Auth.js): AUTH_SECRET, AUTH_TRUST_HOST
